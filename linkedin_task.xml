<?xml version="1.0" encoding="UTF-16"?>
<!--
  linkedin_task.xml — Windows Task Scheduler task definition.

  DO NOT import this file directly. Run install_task.bat instead — it replaces
  PYTHON_PATH_PLACEHOLDER and SCRIPT_PATH_PLACEHOLDER with real paths first.

  Schedule: Every Monday at 8:00 AM local time
  Runs as:  The logged-in user (LogonType=Password), NOT as SYSTEM, so that
            machine-level env vars set by setup_env.bat are visible to the process.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Generates a weekly LinkedIn post on cybersecurity trends using the Anthropic API and emails the draft to the configured recipient every Monday morning.</Description>
    <Author>Brandon Sohm</Author>
    <Date>2026-01-01T00:00:00</Date>
  </RegistrationInfo>

  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-05T08:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Monday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!--
        LogonType=Password means the task runs as the named user account with
        stored credentials, even when no one is logged in. This ensures the
        process inherits machine-level environment variables.
        install_task.bat prompts for credentials during registration.
      -->
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>PYTHON_PATH_PLACEHOLDER</Command>
      <Arguments>SCRIPT_PATH_PLACEHOLDER</Arguments>
      <WorkingDirectory>WORKING_DIR_PLACEHOLDER</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
